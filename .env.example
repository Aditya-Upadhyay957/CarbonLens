# CarbonLens Environment Configuration

# Backend Settings
APP_NAME=CarbonLens
ENVIRONMENT=production
API_PREFIX=/api
DATABASE_URL=sqlite:///./carbonlens.db

# AI / LLM Provider Configuration
# Supported options: "mock" (default, deterministic FinOps engine), "openai", "anthropic"
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloud Provider Simulation
CLOUD_PROVIDER=AWS
AWS_REGION=ap-south-1
SIMULATION_MODE=true

# Carbon Intensity Provider
# Supported options: "simulated" (diurnal regional solar/wind models), "co2signal", "electricitymaps"
CARBON_PROVIDER=simulated
CARBON_API_KEY=

# Default Currency & Rates
DEFAULT_CURRENCY=INR
USD_TO_INR_RATE=83.5
